{{- $items := slice -}}
{{- range (where site.RegularPages "Section" "in" (slice "notes" "projects")).ByTitle -}}
{{- $p := .Params -}}
{{- $it := dict
  "id" .File.ContentBaseName
  "type" (strings.TrimSuffix "s" .Section)
  "title" .Title
  "summary" $p.summary
  "status" $p.status
  "url" .Permalink
  "markdown_url" (.OutputFormats.Get "markdown").Permalink
  "published" (.Date.Format "2006-01-02")
  "last_changed" (.Lastmod.Format "2006-01-02")
  "author" site.Params.author
-}}
{{- with site.Params.sponsor }}{{ $it = merge $it (dict "support_url" .) }}{{ end -}}
{{- with $p.verified_at }}{{ $it = merge $it (dict "verified_at" ((time .).Format "2006-01-02")) }}{{ end -}}
{{- with $p.verified_how }}{{ $it = merge $it (dict "verified_how" .) }}{{ end -}}
{{- with $p.applies_to }}{{ $it = merge $it (dict "applies_to" .) }}{{ end -}}
{{- with $p.keywords }}{{ $it = merge $it (dict "keywords" .) }}{{ end -}}
{{- with $p.superseded_by }}{{ $it = merge $it (dict "superseded_by" (site.GetPage .).Permalink) }}{{ end -}}
{{- range $k := slice "repo" "homepage" "license" "source" }}{{ with index $p $k }}{{ $it = merge $it (dict $k .) }}{{ end }}{{ end -}}
{{- $items = $items | append $it -}}
{{- end -}}
{{- dict "site" site.Title "description" site.Params.description "author" site.Params.author "author_url" site.Params.github "support_url" site.Params.sponsor "license" "CC BY 4.0 (content), MIT (code snippets)" "generated" (now.Format "2006-01-02") "items" $items | jsonify (dict "indent" "  ") -}}
